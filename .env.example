# Database
DB_PASSWORD=strongpassword_change_this

# JWT (must be at least 32 chars)
JWT_SECRET=change-this-to-a-very-long-random-secret-in-production-!!!

# Frontend URL (for CORS, VK redirect, SEO)
FRONTEND_URL=http://localhost
# Optional: comma-separated list when using a custom domain alongside Railway URL
# ALLOWED_ORIGINS=https://lootz.ru,https://www.lootz.ru

# VK ID OAuth
VK_APP_ID=
VK_CLIENT_SECRET=

# Apple Sign In (Services ID)
APPLE_CLIENT_ID=

# Google OAuth (Web client ID + secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

