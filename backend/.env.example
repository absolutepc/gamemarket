NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated origins for custom domain + Railway subdomain
# ALLOWED_ORIGINS=https://lootz.ru,https://www.lootz.ru

DB_HOST=postgres
DB_PORT=5432
DB_NAME=gamemarket
DB_USER=postgres
DB_PASSWORD=strongpassword

JWT_SECRET=change-this-to-a-very-long-random-secret-in-production
LOG_LEVEL=info

# Comma-separated usernames promoted to admin on backend start / migrate
# ADMIN_USERNAMES=Mercy

# VK ID (https://id.vk.com) — App ID + trusted redirect
# Redirect URI: {FRONTEND_URL}/auth/vk/callback
VK_APP_ID=
VK_CLIENT_SECRET=

# Apple Sign In — Services ID (Sign in with Apple)
# Return URL: {FRONTEND_URL}/auth/apple/callback
APPLE_CLIENT_ID=

# Google OAuth (Web client)
# Redirect URI: {FRONTEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

